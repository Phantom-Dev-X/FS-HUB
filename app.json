{
  "expo": {
    "owner": "phantomdevs",
    "scheme": "fshub",
    "name": "FS Hub",
    "slug": "sfa-app-v2",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "runtimeVersion": {
      "policy": "appVersion"
